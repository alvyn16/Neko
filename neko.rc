1 ICON "assets/neko-icon.ico"

1 VERSIONINFO
 FILEVERSION 0,3,1,0
 PRODUCTVERSION 0,3,1,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Neko"
            VALUE "FileDescription", "Neko Wallpaper Manager"
            VALUE "FileVersion", "0.3.1"
            VALUE "InternalName", "neko"
            VALUE "LegalCopyright", "Copyright (c) 2026 alvyn16"
            VALUE "OriginalFilename", "neko.exe"
            VALUE "ProductName", "Neko"
            VALUE "ProductVersion", "0.3.1"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
